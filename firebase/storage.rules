rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Verificaciones: solo admin
    match /verificaciones/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.rol == 'admin';
    }
    // Avatares: owner o admin
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.rol == 'admin') && request.resource.size < 2 * 1024 * 1024;
    }
    // Documentos: solo owner o admin via signed URL
    match /documentos/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.token.rol in ['egresado_verificado', 'admin']);
      allow write: if request.auth != null && request.auth.token.rol == 'admin';
    }
  }
}
