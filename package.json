{"name": "fray-placido-portal", "version": "1.0.0", "private": true, "workspaces": ["frontend", "backend", "firebase/functions"], "scripts": {"dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run start --workspace=backend\"", "build": "npm run build --workspace=frontend && npm run build --workspace=backend", "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend", "test": "npm run test --workspace=backend", "e2e": "npm run e2e --workspace=backend", "firebase:serve": "firebase serve", "firebase:deploy": "firebase deploy"}, "devDependencies": {"concurrently": "^8.2.2", "typescript": "^5.4.5", "prettier": "^3.3.2"}}